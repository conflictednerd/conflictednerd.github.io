---
layout: book
prose: true
---
{% comment %} Tag, category and year archives (jekyll-archives-v2), listed like the notes on the home page. {% endcomment %}
{% case page.type %}
  {% when 'year' %}
    {% assign kind = 'Notes from' %}
    {% assign name = page.date | date: '%Y' %}
  {% when 'tags' %}
    {% assign kind = 'Notes tagged' %}
    {% assign name = page.title | replace: '-', ' ' %}
  {% else %}
    {% assign kind = 'Notes in the category' %}
    {% assign name = page.title | replace: '-', ' ' %}
{% endcase %}
<main id="top">
  <header class="title doc-head">
    <p class="eyebrow sc">{{ kind }}</p>
    <h1>{{ name }}</h1>
  </header>

  <section class="sec" data-title="{{ kind }} {{ name | escape }}">
    <div class="body">
      <aside class="mn note" id="toc-note"><a href="{{ '/blog/' | relative_url }}">All notes</a></aside>
      {% include book/notes.liquid posts=page.documents %}
    </div>
  </section>
</main>
