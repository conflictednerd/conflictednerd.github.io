---
layout: book
prose: true
---
{% comment %} A note (blog post): head, text column with an optional contents list in the margin, and links to the neighbouring notes. {% endcomment %}
{% assign year = page.date | date: '%Y' %}
<main id="top">
  <header class="title doc-head">
    <p class="eyebrow sc">
      {{ page.date | date: '%-d %B' }}
      <a href="{{ '/blog/' | append: year | append: '/' | relative_url }}">{{ year }}</a>
    </p>
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p class="dek">{{ page.description }}</p>
    {% endif %}
    <p class="filed">
      {% for tag in page.tags %}
        <a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">{{ tag | replace: '-', ' ' }}</a>
      {% endfor %}
      {% for category in page.categories %}
        <a href="{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}">{{ category | replace: '-', ' ' }}</a>
      {% endfor %}
    </p>
  </header>

  {% comment %} data-title: the running head shows the note's title once this element scrolls under it. {% endcomment %}
  <article class="sec" data-title="{{ page.title | escape }}">
    <div class="body">
      {% if page.toc %}
        <nav class="mn note doc-toc" aria-label="Contents">
          <span class="sc">Contents</span>
          {{ content | toc_only }}
        </nav>
      {% endif %}
      <div class="article">
        {{ content }}
      </div>
    </div>
  </article>

  <nav class="doc-end" aria-label="More notes">
    {% if page.previous %}
      <a class="prev" href="{{ page.previous.url | relative_url }}"><span class="sc">Previous</span> {{ page.previous.title }}</a>
    {% endif %}
    {% if page.next %}
      <a class="next" href="{{ page.next.url | relative_url }}"><span class="sc">Next</span> {{ page.next.title }}</a>
    {% endif %}
    <a class="all" href="{{ '/blog/' | relative_url }}">All notes</a>
  </nav>
</main>
