---
layout: book
prose: true
---
{% comment %} A plain page (privacy, 404): title, optional description, then the content in the text column. {% endcomment %}
<main id="top">
  <header class="title doc-head">
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p class="dek">{{ page.description }}</p>
    {% endif %}
  </header>

  <article class="sec" data-title="{{ page.title | escape }}">
    <div class="body article">
      {{ content }}
    </div>
  </article>
</main>
